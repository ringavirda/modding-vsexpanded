# Ignore rules for this repo. 
# Generic .NET/IDE rules first, repo-specific rules second.

#
# .NET/IDE
#

# User-specific IDE state.
*.rsuser
*.suo
*.user
*.sln.docstates
*.DotSettings.user

# Build results.
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Oo]bj/

# Logs and temporaries.
*.log
*.tlog
*.tmp

# Visual Studio / Rider caches.
.vs/
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper

# Visual Studio cache files.
# files ending in .cache can be ignored.
*.[Cc]ache
# but keep track of directories ending in .cache.
!?*.[Cc]ache/
# ...and .lscache, which the pattern above does NOT match. 
*.lscache

# Test and coverage output.
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# VS Code: ignore everything except the shared workspace files.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

#
# Repo-specific
#

# Downloaded Vintage Story installs + cached archives.
/.game/

# Vintage Story data dir the game generates under the repo via --dataPath.
/.gamedata/

# Self-contained .NET (SDK + runtimes).
/.dotnet/

# Local sources of other mods to maintain compatibility with (reference only).
/.compat/

# Dependency mods provision resolves and caches: workspace siblings build their own, so this only
# ever holds a release download.
/.exmod/

# extools, cloned by scripts/exmod.sh or scripts/exmod.ps1 when no sibling checkout is found.
/.extools/

# Release zips built by the extools packaging build, the NuGet packages built by `exmod nuget`,
# and the flat asset folder the release workflow collects both into.
/dist/Releases/
/dist/nuget/
/dist/assets/
