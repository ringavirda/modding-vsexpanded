# Ignore rules for this repo. Generic .NET/IDE rules first, repo-specific rules (with rationale)
# below.

# --- .NET / IDE ------------------------------------------------------------

# User-specific IDE state
*.rsuser
*.suo
*.user
*.sln.docstates
*.DotSettings.user

# Build results
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Oo]bj/

# Logs and temporaries (also covers a stray /launch.log from the vsdbg --tracelog launch config)
*.log
*.tlog
*.tmp

# Visual Studio / Rider caches
.vs/
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!?*.[Cc]ache/
# ...and .lscache, which the pattern above does NOT match (the dot must precede "cache", and here it
# precedes "lscache"). These are LanguageService per-project caches; two were tracked for months.
*.lscache

# Test + coverage output
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# --- Repo-specific ---------------------------------------------------------

# Downloaded Vintage Story installs (per version) + cached archives, provisioned by
# scripts/provision-game.* - never committed.
/.game/

# Vintage Story data dir (saves, configs, logs) the game generates under the repo via --dataPath.
/.gamedata/

# Self-contained .NET (SDK + runtimes) provisioned by scripts/provision-dotnet.* for clones that
# don't have the required .NET 7/8/10 installed system-wide.
/.dotnet/

# Local sources of third-party mods we maintain compatibility with (reference only, not ours).
/.compat/

# Release zips built by dist/CakeBuild. scripts/gen-released-codes.py reads these - they are
# machine-local and not reproducible from a clone.
/dist/Releases/

# VS Code: ignore everything except the shared workspace files.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
