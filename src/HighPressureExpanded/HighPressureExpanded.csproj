<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Primary build is the current game version, single-target. Opt into the older versions
         with -p:Legacy=true; both the primary TFM and the full legacy set come from the manifest
         in ../Directory.Build.props (add a version there, not here). -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath
      Condition="'$(IsCurrentGame)' != 'true' and '$(TargetFramework)' != ''"
      >bin\$(Configuration)\$(TargetFramework)\Mods\mod</OutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''"
      >bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
    <!-- This mod's asset domain; the shared globs in ../Directory.Build.props pull in
         ../../assets/hpex/ (Content + the en.json ExLangKeyGenerator feed). -->
    <AssetDomain>hpex</AssetDomain>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VGameContent">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VGameContent">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(GamePath)/Lib/cairo-sharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/Lib/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Stamp the matching game version into the output modinfo for legacy builds; no-op on the
       current version (its modinfo already carries $(CurrentGameVer).0). -->
  <Target
    Name="RewriteModinfoGameVersion"
    AfterTargets="Build"
    Condition="'$(GameVersion)' != ''"
  >
    <WriteLinesToFile
      File="$(OutDir)modinfo.json"
      Lines="$([System.IO.File]::ReadAllText('$(OutDir)modinfo.json').Replace('&quot;game&quot;: &quot;$(CurrentGameVer)&quot;', '&quot;game&quot;: &quot;$(GameVersion)&quot;'))"
      Overwrite="true"
    />
  </Target>

  <!--
    hpex is the top of the steam chain: it holds only the high-pressure LEAVES (Lancashire boiler,
    Cornish engine), which inherit essentially everything from iiex's boiler/engine bases
    (BlockBoiler/BlockEntityBoiler, BlockEngine/BlockEntityEngine, the geometry interfaces, the
    renderers and the sub-machine bases). exlib supplies the framework (networks, structures, RCC,
    definitions). It does NOT reference smex: the Cornish engine drives smex's air blower purely
    through iiex's BlockEntityEngine base contract, so there is no code edge. Reference the built
    dlls; Private=false because the player installs exlib/iiex/iiex as their own mods, so none of
    those dlls is bundled into hpex's output.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ExpandedLib\ExpandedLib.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!--
      ⛔ iiex must stay declared EXPLICITLY, not left to arrive transitively through exlib. Before the
      merge that mattered for a second mod; it still matters for this one. `<Private>false</Private>`
      suppresses copy-local for the one item it sits on and does NOT propagate to a project's
      transitive closure, so without an explicit item the SDK synthesises a transitive
      ProjectReference with the default Private=true and copies iiex.dll into hpex's output - a
      second assembly carrying a ModSystem, which makes Vintage Story refuse to load the mod at all
      ("Found multiple .dll files with ModSystems and/or ModInfo attributes"), leaving hpex silently
      absent from the loaded-mod list. This affects the release zip as well as local staging:
      dist/CakeBuild stages `publish/*`, and publish copies runtime deps the same way.
      DisableTransitiveProjectReferences is not the fix - it strips the compile reference too, and
      hpex uses iiex types directly (BlockNetworkPipe.Blocks). modinfo.json already declares iiex.
      ⛔ Verify by staging the output and counting ModSystem-bearing dlls, never by reading this file:
      the failure is green in every test run and visible only in game.
    -->
    <ProjectReference Include="..\IronIndustryExpanded\IronIndustryExpanded.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- Source generator that emits the HpexValues accessor from the [ExConfig] HpexConfig POCO.
         OutputItemType=Analyzer + ReferenceOutputAssembly=false: compile-time only, ships nothing. -->
    <ProjectReference
      Include="..\ExpandedLib.Generators\ExpandedLib.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
