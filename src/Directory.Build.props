<Project>
  <!--
    ============================================================================================
    SINGLE SOURCE OF TRUTH for the supported VintageStory versions: the "VERSION MANIFEST" region
    below is the ONLY place to edit when the version set changes.

    To ADD a version: append its TFM to $(AllGameTfms), add a per-version PropertyGroup (game
    version + folder slug + install env var), and add one GAME_GE_<ver> line in the
    capability-constants block.
    To PROMOTE a new primary (e.g. when 1.22 becomes legacy and 1.23 arrives): point
    $(CurrentGameTfm)/$(CurrentGameVer) at the new row (leaving the old one in $(AllGameTfms)).

    Nothing in the csprojs or the #if-guarded code changes for a version move - it all derives
    from here:
      * $(CurrentGameTfm)/$(AllGameTfms) - csprojs read these for TargetFramework(s)
      * $(GamePath)/$(GameVer)/$(GameVersion) - per-TFM install, version, modinfo stamp
      * GAME_GE_<major>_<minor> compile constants - defined for every version <= the one being
        built, so code guards on a CAPABILITY THRESHOLD (#if GAME_GE_1_22) not a raw TFM
        (#if NET10_0). A threshold stays correct as newer versions appear: 1.23 is also >= 1.22,
        so a "#if GAME_GE_1_22" current-API path keeps covering it and a "#if !GAME_GE_1_22"
        legacy shim keeps covering only < 1.22 - including 1.22 itself once it is no longer
        primary. (Mods are written against the CURRENT API; a shim bridges an OLDER version up to
        it, so its guard is "version < where-this-API-arrived".)
      * GameInstallEnv assembly metadata - lets runtime code (the test harness resolver) pick the
        matching install without its own #if ladder.

    Only an ACTUAL new API divergence still needs hand-written code: add a GAME_GE_<new> guard +
    the shim. The plumbing never needs per-version edits again.

    NOTE on evaluation: properties are evaluated before items in MSBuild, so the manifest is
    properties (not an item list) to stay robust. $(TargetFramework) is empty during evaluation of
    the default single-target / outer multi-target build (it's only a global property in the
    legacy inner builds), so $(_GameTfm) falls back to the primary TFM.
    ============================================================================================
  -->

  <!-- ===================== VERSION MANIFEST (edit only this region) ===================== -->
  <!-- GameVer is the game-version FLOOR each TFM supports - the .0 of the series - and is stamped
       into the legacy output modinfo. The mods are kept source-compatible with that .0 release (so
       a player on any patch of the series can run them); the legacy shims target the .0 API surface.
       (The GAME_GE_* thresholds below compare on major.minor, so the patch component is irrelevant
       there.) -->
  <PropertyGroup>
    <CurrentGameTfm>net10.0</CurrentGameTfm>
    <CurrentGameVer>1.22.0</CurrentGameVer>
    <AllGameTfms>net7.0;net8.0;net10.0</AllGameTfms>
  </PropertyGroup>

  <PropertyGroup>
    <_GameTfm>$(TargetFramework)</_GameTfm>
    <_GameTfm Condition="'$(_GameTfm)' == ''">$(CurrentGameTfm)</_GameTfm>
    <IsCurrentGame Condition="'$(_GameTfm)' == '$(CurrentGameTfm)'"
      >true</IsCurrentGame>
  </PropertyGroup>

  <!-- Per-version facts: game version floor + the .game/<slug> folder it provisions into + the env
       var that can override the install location. One per TFM. -->
  <PropertyGroup Condition="'$(_GameTfm)' == 'net10.0'">
    <GameVer>1.22.0</GameVer>
    <GameSlug>1.22</GameSlug>
    <GameInstallEnv>VINTAGE_STORY</GameInstallEnv>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_GameTfm)' == 'net8.0'">
    <GameVer>1.21.0</GameVer>
    <GameSlug>1.21</GameSlug>
    <GameInstallEnv>VINTAGE_STORY_121</GameInstallEnv>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_GameTfm)' == 'net7.0'">
    <GameVer>1.20.0</GameVer>
    <GameSlug>1.20</GameSlug>
    <GameInstallEnv>VINTAGE_STORY_120</GameInstallEnv>
  </PropertyGroup>

  <!-- Capability-threshold compile constants: GAME_GE_<ver> for every version <= the one built. -->
  <PropertyGroup Condition="'$(GameVer)' != ''">
    <DefineConstants
      Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(GameVer)', '1.20'))"
      >$(DefineConstants);GAME_GE_1_20</DefineConstants>
    <DefineConstants
      Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(GameVer)', '1.21'))"
      >$(DefineConstants);GAME_GE_1_21</DefineConstants>
    <DefineConstants
      Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(GameVer)', '1.22'))"
      >$(DefineConstants);GAME_GE_1_22</DefineConstants>
  </PropertyGroup>
  <!-- =================== end VERSION MANIFEST =================== -->

  <!-- Game version stamped into the legacy output modinfo (current keeps the authored value). -->
  <PropertyGroup>
    <GameVersion Condition="'$(IsCurrentGame)' != 'true' and '$(GameVer)' != ''"
      >$(GameVer)</GameVersion>
  </PropertyGroup>

  <!-- $(GamePath) = the install for THIS TFM. Priority:
         1. An explicit env-var override (its name is in $(GameInstallEnv)) - used by CI and by anyone
            pointing the build at an external install.
         2. Otherwise the in-repo install provisioned into .game/<slug> by scripts/exmod.*
       Both the env-var name and the slug come from the manifest above, so there are no per-version
       branches and no machine-specific .env file to maintain. -->
  <PropertyGroup Condition="'$(GameInstallEnv)' != ''">
    <!-- The raw env-var value (empty when there's no override): lets the auto-provision target tell an
         external install (leave alone) from the default in-repo .game/<slug> (safe to populate). -->
    <_GamePathEnv>$([System.Environment]::GetEnvironmentVariable('$(GameInstallEnv)'))</_GamePathEnv>
    <GamePath Condition="'$(GamePath)' == ''">$(_GamePathEnv)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and '$(GameSlug)' != ''"
      >$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\.game\$(GameSlug)'))</GamePath>
  </PropertyGroup>

  <!-- Version to auto-provision: the primary tracks the latest patch (pass the major.minor series so
       provision-game resolves it); the legacy targets pin the series .0 floor. -->
  <PropertyGroup>
    <_ProvisionVersion Condition="'$(IsCurrentGame)' == 'true'"
      >$(GameSlug)</_ProvisionVersion>
    <_ProvisionVersion Condition="'$(IsCurrentGame)' != 'true'"
      >$(GameVer)</_ProvisionVersion>
  </PropertyGroup>

  <!-- Expose the install env-var name and the .game/<slug> folder to runtime code (the test harness
       assembly resolver) so it loads the matching version's assemblies without its own per-TFM #if
       ladder - resolving the same way the build does (env override first, else the in-repo install). -->
  <ItemGroup Condition="'$(GameInstallEnv)' != ''">
    <AssemblyMetadata Include="GameInstallEnv" Value="$(GameInstallEnv)" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameSlug)' != ''">
    <AssemblyMetadata Include="GameSlug" Value="$(GameSlug)" />
  </ItemGroup>

  <!-- The pre-current game APIs have less complete nullable-reference annotations, so passing null
       to params they accept-but-don't-mark-nullable trips CS8625. Benign cross-version difference;
       suppress it on the legacy targets only - the current build keeps full nullable checking.

       CS1574 joins it for the same reason: a doc comment citing an API that only exists on the
       current game version cannot resolve on an older one, and there is no single cref that works
       across both. The current build keeps the warning, which is where it catches a cref that has
       gone stale against our own code. -->
  <PropertyGroup Condition="'$(IsCurrentGame)' != 'true'">
    <NoWarn>$(NoWarn);CS8625;CS1574</NoWarn>
  </PropertyGroup>

  <!--
    ============================================================================================
    ASSEMBLY IDENTITY AND XML DOCS, for the five projects that ship as mods.

    Keyed on the project having its own modinfo.json, NOT on $(AssetDomain): the csproj sets
    $(AssetDomain) and properties in this file are evaluated BEFORE the csproj, so a property
    conditioned on it here is silently inert - always false, and nothing errors. (The
    $(AssetDomain)-conditioned ItemGroups further down are fine: items are evaluated after every
    property from both files.) modinfo.json is present for exactly the five mod projects and absent
    from ExpandedLib.Generators and every test project, so it is both the correct marker and one
    that is available this early.

    VERSION. Every release shipped AssemblyVersion/FileVersion 1.0.0.0, so nothing outside the
    running game could tell one build from another: the only version identity was a string in
    modinfo.json, readable at runtime only, after the mod had already loaded and possibly already
    called a method that no longer exists. modinfo.json stays the single source - the version is read
    out of it rather than duplicated - so the two cannot drift and a release still edits one file.
    AssemblyVersion deliberately stays major.minor.0.0 while FileVersion carries the patch: a binding
    identity that changed on every patch would break a dependent mod's assembly reference over a
    bugfix, which is not what a patch release means.

    DOCS. Nearly every public member carries a <summary> explaining the engine trap it exists for
    rather than restating the signature, and none of it reached a consumer - no .xml was produced, so
    a third party referencing the shipped dll got bare signatures across the whole public surface
    while vanilla's own types showed full tooltips in the same IntelliSense list. CS1591 (missing
    comment on a public member) is suppressed rather than gated: producing the file is the change,
    and burning down the undocumented remainder is a separate pass that should not block it.
    ============================================================================================
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\modinfo.json')">
    <ModVersion Condition="'$(ModVersion)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\modinfo.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
    <Version>$(ModVersion)</Version>
    <FileVersion>$(ModVersion)</FileVersion>
    <InformationalVersion>$(ModVersion)</InformationalVersion>
    <AssemblyVersion>$([System.Version]::Parse('$(ModVersion)').Major).$([System.Version]::Parse('$(ModVersion)').Minor).0.0</AssemblyVersion>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 missing comment on a public member - the undocumented remainder, a separate pass.
         CS1573 a parameter has no <param> tag - this codebase documents behaviour in <summary> prose
           rather than tagging every parameter, deliberately, so this fires on the house style.
         CS0419 an ambiguous cref across an overload set - the link still resolves to one of them.
         ⛔ CS1574 (a cref that resolves to NOTHING) is deliberately NOT suppressed: it is the only
         one of these that catches a doc statement which has gone stale against the code, and turning
         the doc file on found six on the first build. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
  </PropertyGroup>

  <!-- Auto-provision the SERVER binaries into .game/<slug> when they're missing and no env override is
       set, so a fresh `dotnet build` / `dotnet test` works seamlessly with no manual step. The playable
       client is never fetched here - only the launch tasks pull it (provision-game ... -Kind client). -->
  <Target
    Name="_AutoProvisionGame"
    Condition="'$(GameSlug)' != '' and '$(_GamePathEnv)' == '' and !Exists('$(GamePath)\VintagestoryAPI.dll')"
  >
    <Message
      Importance="high"
      Text="Vintage Story $(_ProvisionVersion) not found - provisioning server binaries into .game\$(GameSlug) ..."
    />
    <!-- One implementation (exmod.ps1); exmod.sh is the POSIX launcher, which also bootstraps pwsh
         when the machine has none. -->
    <Exec
      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../scripts/exmod.ps1&quot; provision game -Version $(_ProvisionVersion) -Kind server"
    />
    <Exec
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
      Command="bash &quot;$(MSBuildThisFileDirectory)../scripts/exmod.sh&quot; provision game -Version $(_ProvisionVersion) -Kind server"
    />
  </Target>

  <!-- Fail clearly (instead of a cryptic CS1705 assembly-version mismatch) if, after the auto-provision
       attempt, the binaries still aren't there (e.g. offline, or an env override pointing nowhere). -->
  <Target
    Name="_CheckGamePath"
    BeforeTargets="ResolveAssemblyReferences"
    DependsOnTargets="_AutoProvisionGame"
    Condition="'$(GamePath)' != ''"
  >
    <Error
      Condition="!Exists('$(GamePath)\VintagestoryAPI.dll')"
      Text="Can't find the Vintage Story $(GameVer) install (GamePath='$(GamePath)'). Provision it with 'scripts/exmod.sh provision game -Version $(_ProvisionVersion) -Kind server', or set the $(GameInstallEnv) environment variable to an existing install."
    />
  </Target>

  <!--
    ============================================================================================
    SHARED MOD ASSET GLOBS. The four mod asset trees live at the repo root (../assets/<domain>/),
    hoisted out of each src/<Mod>/ so non-code contributors (translators, shape/texture artists)
    have a single top-level assets/ view and never touch src/. Because domain == mod 1:1, each mod
    csproj declares its one <AssetDomain> and these two globs pull that domain's tree in:
      * Content  - packaged into the mod (needs <Link> because the files are OUT of the project
        cone; without it MSBuild flattens them to the output root instead of assets/<domain>/…).
      * AdditionalFiles - the en.json feed for ExLangKeyGenerator (compile input, not shipped).
    Guarded on $(AssetDomain) so this is inert for the non-mod projects that also see this file:
    ExpandedLib.Generators (under src/) and every test csproj (test/Directory.Build.props imports
    this one). It is a pure MSBuild relocation - invisible to the game, which only cares about the
    assets/<domain>/… layout INSIDE the packaged mod.
    ============================================================================================
  -->
  <!-- One shared legacy-usings shim for every mod project (all of which set $(AssetDomain)): on the
       legacy TFMs it pulls exlib's Legacy namespace into scope assembly-wide, and it compiles away on
       the current TFM. Linked here so the five projects share one file instead of per-project copies. -->
  <ItemGroup Condition="'$(AssetDomain)' != ''">
    <Compile Include="$(MSBuildThisFileDirectory)LegacyUsings.cs">
      <Link>LegacyUsings.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- $(AssetDomain) is the mod's PRIMARY domain: its lang feed, and the one its own codes use.
       $(AssetDomainsExtra) is an optional semicolon-separated list of FURTHER trees it packs - a mod
       ships more than one while absorbing another's codes during a merge, because the absorbed tree
       keeps shipping under its own domain until the codes relocate. iiex's game-domain lang override
       is the same mechanism rather than a special case.

       ⚠ These must stay ITEM conditions. Properties in this file are evaluated BEFORE the csproj sets
       $(AssetDomain), so computing an intermediate property here is silently inert - no assets, no
       AdditionalFiles, and no error. Items are evaluated after every property from both files, which
       is why the original single-domain glob worked. -->
  <!-- The Content globs that pack these trees live in ../Directory.Build.targets: they need a property
       computed from $(AssetDomain), which the csproj sets AFTER this file is evaluated. Only the
       PRIMARY domain feeds ExLangKeyGenerator - a packed foreign tree is either an override of someone
       else's keys (assets/game/) or an absorbed mod's own, and neither should emit typed constants into
       this mod's {Domain}Lang class - and an AdditionalFiles item needs no computed property, so it
       stays here. -->
  <ItemGroup Condition="'$(AssetDomain)' != ''">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\assets\$(AssetDomain)\lang\en.json" />
  </ItemGroup>

  <!--
    ============================================================================================
    OPT-IN GAME-DOMAIN OVERRIDE. A mod that sets <ShipGameLangOverride>true</> packs the shared
    assets/game/ tree (lang overrides that rename vanilla keys - iron -> "wrought iron", steel ->
    "shear steel"). Only ONE mod may opt in, or the override would ship duplicated; today that is
    iiex.

    It is now a spelling of $(AssetDomains) rather than its own glob: the property block above
    appends "game" to the list, and the shared Content glob packs it like any other tree. The lang
    files are pure overrides (no new codes), and only the primary domain feeds
    ExLangKeyGenerator, so nothing emits typed constants for game/.
    ============================================================================================
  -->
</Project>
