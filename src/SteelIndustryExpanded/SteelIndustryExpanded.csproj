<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Primary build is the current game version, single-target. Opt into the older versions
         with -p:Legacy=true; both the primary TFM and the full legacy set come from the manifest
         in ../Directory.Build.props (add a version there, not here). -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath
      Condition="'$(IsCurrentGame)' != 'true' and '$(TargetFramework)' != ''"
      >bin\$(Configuration)\$(TargetFramework)\Mods\mod</OutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''"
      >bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
    <!-- Stated rather than left to derive from the folder name, which otherwise silently controls
         both: the dll the game loads, and the namespace ExLangKeyGenerator emits {Domain}Lang into. -->
    <AssemblyName>siex</AssemblyName>
    <RootNamespace>SteelIndustryExpanded</RootNamespace>
    <!-- This mod's asset domain; the shared globs in ../Directory.Build.props pull in
         ../../assets/siex/ (Content + the en.json ExLangKeyGenerator feed). -->
    <AssetDomain>siex</AssetDomain>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VGameContent">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VGameContent">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(GamePath)/Lib/cairo-sharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/Lib/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Stamp the matching game version into the output modinfo for legacy builds; no-op on the
       current version (its modinfo already carries $(CurrentGameVer).0). -->
  <Target
    Name="RewriteModinfoGameVersion"
    AfterTargets="Build"
    Condition="'$(GameVersion)' != ''"
  >
    <WriteLinesToFile
      File="$(OutDir)modinfo.json"
      Lines="$([System.IO.File]::ReadAllText('$(OutDir)modinfo.json').Replace('&quot;game&quot;: &quot;$(CurrentGameVer)&quot;', '&quot;game&quot;: &quot;$(GameVersion)&quot;'))"
      Overwrite="true"
    />
  </Target>

  <!--
    siex builds on the shared framework in exlib (network/structure base types, single
    BlockNetworkModSystem identity) and on iiex, whose pipe network, pipe blocks, molten-metal
    network and canals/taps/barrels/pedestals it uses directly. Reference the built dlls;
    Private=false because the player installs exlib and iiex as their own mods, so neither dll is
    bundled into siex's output - a second ModSystem-bearing dll in the folder makes Vintage Story
    refuse to load the mod at all.
    Verify by staging the output and counting ModSystem-bearing dlls, never by reading this file:
    the failure is green in every test run and visible only in game.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ExpandedLib\ExpandedLib.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\IronIndustryExpanded\IronIndustryExpanded.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- Source generator that emits the SiexValues accessor from the [ExConfig] SiexConfig POCO.
         OutputItemType=Analyzer + ReferenceOutputAssembly=false: compile-time only, ships nothing. -->
    <ProjectReference
      Include="..\ExpandedLib.Generators\ExpandedLib.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
