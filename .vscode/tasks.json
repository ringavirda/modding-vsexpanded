{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "launch-prep (latest)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "provision-game (1.22)",
        "stage-mods (latest)"
      ],
      "problemMatcher": []
    },
    {
      "label": "stage-mods (latest)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "stage"
      ],
      "problemMatcher": []
    },
    {
      "label": "Publish mods",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "pack"
      ],
      "problemMatcher": []
    },

    // ----------------------------------------------------------------------------------------
    // Test runners - separate, independently-runnable targets per game version. Each builds the
    // test projects for that version (auto-provisioning its game binaries on demand) and runs the
    // suite; projects run in parallel. "Test: all" runs every version concurrently. Pick one from
    // "Run Test Task", or run any via "Run Task".
    // ----------------------------------------------------------------------------------------
    {
      "label": "Test: latest (1.22)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "test",
        "latest"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: 1.21 (legacy)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "test",
        "1.21"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: 1.20 (legacy)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "test",
        "1.20"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: all versions (parallel)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "test",
        "all"
      ],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Test: coverage (latest + gate)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "test",
        "-Coverage"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "provision-game (1.22)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "provision",
        "game",
        "-Version",
        "1.22",
        "-Kind",
        "client"
      ],
      "problemMatcher": []
    },

    // ----------------------------------------------------------------------------------------
    // Legacy game versions (1.21 -> net8.0, 1.20 -> net7.0). `exmod stage -Version <x.y>` builds
    // the mods for that series (opting into -p:Legacy=true itself) and stages them into
    // bin/Mods-<x.y>, so launch-prep for a legacy series is provisioning plus that one call.
    // ----------------------------------------------------------------------------------------
    {
      "label": "provision-game (1.21)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "provision",
        "game",
        "-Version",
        "1.21.0",
        "-Kind",
        "client"
      ],
      "problemMatcher": []
    },
    {
      "label": "provision-game (1.20)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "provision",
        "game",
        "-Version",
        "1.20.0",
        "-Kind",
        "client"
      ],
      "problemMatcher": []
    },
    {
      "label": "launch-prep (1.21)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "provision-game (1.21)",
        "stage-mods (1.21)"
      ],
      "problemMatcher": []
    },
    {
      "label": "launch-prep (1.20)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "provision-game (1.20)",
        "stage-mods (1.20)"
      ],
      "problemMatcher": []
    },
    {
      "label": "stage-mods (1.21)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "stage",
        "-Version",
        "1.21"
      ],
      "problemMatcher": []
    },
    {
      "label": "stage-mods (1.20)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/exmod.ps1",
        "stage",
        "-Version",
        "1.20"
      ],
      "problemMatcher": []
    }
  ]
}
