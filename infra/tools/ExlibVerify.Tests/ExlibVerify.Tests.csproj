<Project Sdk="Microsoft.NET.Sdk">
  <!-- infra/tools/ sits outside mods/, so it does not inherit ../../mods/Directory.Build.props the
       way every mod test project does automatically - imported explicitly for $(GamePath), the
       same way samples/HelloExpanded.csproj does. -->
  <Import Project="../../../mods/Directory.Build.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExlibVerify\ExlibVerify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read straight off disk by ModSource.Load at test run time - never copied into the test
         output, since the checker addresses fixtures by their source path. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
