<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Matches the harness's own default TFM (mods/Directory.Build.props' CurrentGameTfm); this
         project sits outside mods/ so it does not inherit that file and states it directly. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ExpandedLib.Tools.BlockCodeEmitter</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls in exlib, iiex and siex too (each mod's own src project, transitively): the tool needs
         one already-compiled type per mod as an assembly anchor, the same way each mod's own
         *BlocksCodeTests fixture does. -->
    <ProjectReference Include="..\..\..\mods\exlib\src\ExpandedLib.csproj" />
    <ProjectReference Include="..\..\..\mods\exlib\testing\ExpandedLib.Testing.csproj" />
    <ProjectReference Include="..\..\..\mods\iiex\src\IronIndustryExpanded.csproj" />
    <ProjectReference Include="..\..\..\mods\siex\src\SteelIndustryExpanded.csproj" />
  </ItemGroup>
</Project>
