<Project Sdk="Microsoft.NET.Sdk">
  <!-- infra/tools/ sits outside mods/, so it does not inherit ../../mods/Directory.Build.props the
       way every mod project does automatically - imported explicitly for $(GamePath), the same way
       samples/HelloExpanded.csproj does. -->
  <Import Project="../../../mods/Directory.Build.props" />

  <PropertyGroup>
    <!-- Matches the harness's own default TFM ($(CurrentGameTfm) from the import above), stated
         directly since this tool always targets the current game version only. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ExpandedLib.Verify</RootNamespace>
    <AssemblyName>exlib-verify</AssemblyName>
  </PropertyGroup>

  <!-- Packed as a .NET global tool (dotnet tool install ExpandedLib.Verify): a JSON-only modder
       gets the `exlib-verify` command with no game licence, no built mod dll, and no xUnit runner -
       see release.yml, which packs and ships this alongside the two libraries. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>exlib-verify</ToolCommandName>
    <PackageId>ExpandedLib.Verify</PackageId>
    <_ModinfoJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\mods\exlib\src\modinfo.json'))</_ModinfoJson>
    <PackageVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ModinfoJson), '&quot;version&quot;:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</PackageVersion>
    <Authors>fallenstar</Authors>
    <Description>Headless JSON-only mod checker for Vintage Story - patch application, recipe and handbook lang coverage, without the game running.</Description>
    <RepositoryUrl>https://github.com/ringavirda/modding-vsexpanded</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- AssetLocation, WildcardUtil - the same asset-addressing types the game itself uses, so a
         patch target or a recipe code resolves exactly the way it would in game. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own RFC-6902 patch engine, applied against the real target document the same
         way ModJsonPatchLoader (vsessentialsmod) drives it. -->
    <Reference Include="Tavis.JsonPatch">
      <HintPath>$(GamePath)/Lib/Tavis.JsonPatch.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- Explicit import: GamePath (used above via HintPath) lives in ExpandedLib.targets,
       imported after the project body - the mods/Directory.Build.props import above only
       carries ExpandedLib.props (the props half), and this project sits outside mods/, so
       the auto-imported mods/Directory.Build.targets never reaches it either. -->
  <Import Project="../../../mods/exlib/build/ExpandedLib.targets" />
</Project>
