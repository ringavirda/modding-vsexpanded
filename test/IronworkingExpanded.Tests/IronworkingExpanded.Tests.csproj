<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10 (1.22) by default; -p:Legacy=true also tests net8.0 (1.21) + net7.0 (1.20). The
         scripts/run-tests.* helper (and the "Test: …" VS Code tasks) run each version separately. -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=true (unlike the other test projects, which leave it false). The vstest discoverer
         probes a test assembly's direct references on disk BEFORE the harness's assembly resolver can
         run; when VintagestoryAPI is not in the output folder it can silently SKIP the whole assembly
         ("could not find dependent assembly 'VintagestoryAPI, Version=…'") and report zero tests
         rather than failing - which is how this project quietly contributed nothing on the legacy
         lane. Copying the dll in is dev-only output (never shipped) and makes discovery deterministic.
         TODO: the same fragility likely affects the other suites; roll this out once understood. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Mocking framework for faking the game's big API interfaces in BE/unit tests. -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy exlib.dll + iwex.dll into the test bin so the runner loads them headlessly; their VS
         deps are resolved by VsAssemblyResolver from the $(VINTAGE_STORY) install. iwex is the
         lowest content mod, so this project references NO other mod - the lpex reference it used to
         carry was a leftover from before the pipe move inverted the chain, and nothing here used it. -->
    <ProjectReference Include="..\..\src\ExpandedLib\ExpandedLib.csproj" />
    <ProjectReference Include="..\..\src\IronworkingExpanded\IronworkingExpanded.csproj" />
    <ProjectReference Include="..\ExpandedLib.Testing\ExpandedLib.Testing.csproj" />
  </ItemGroup>


</Project>
