<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10 (1.22) by default; -p:Legacy=true also tests net8.0 (1.21) + net7.0 (1.20). The
         scripts/run-tests.* helper (and the "Test: …" VS Code tasks) run each version separately. -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Mocking framework for faking the game's big API interfaces in BE/unit tests. -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy exlib.dll + lpex.dll + hpex.dll into the test bin so the runner loads them headlessly;
         their VS deps are resolved by VsAssemblyResolver from the $(VINTAGE_STORY) install. lpex is
         needed for the boiler/engine bases the two HP leaves derive from. -->
    <ProjectReference Include="..\..\src\ExpandedLib\ExpandedLib.csproj" />
    <ProjectReference Include="..\..\src\IronworkingExpanded\IronworkingExpanded.csproj" />
    <ProjectReference Include="..\..\src\LowPressureExpanded\LowPressureExpanded.csproj" />
    <ProjectReference Include="..\..\src\HighPressureExpanded\HighPressureExpanded.csproj" />
    <!-- TEST-ONLY smex reference. The Cornish engine drives smex's air blower entirely through
         lpex's BlockEntityEngine base contract, so hpex has no smex *code* edge - but the
         end-to-end air-blower scenario needs both types in one assembly, and smex must never
         reference hpex. This direction is the safe one: it matches the shipped chain (hpex's
         modinfo already declares a smex dependency) and cannot create a cycle. -->
    <ProjectReference Include="..\..\src\SteelmakingExpanded\SteelmakingExpanded.csproj" />
    <ProjectReference Include="..\ExpandedLib.Testing\ExpandedLib.Testing.csproj" />
    <!-- Content-specific fixtures follow the mod chain: pipes from the iwex suite, the shared
         engine/boiler plants from the lpex suite. -->
    <ProjectReference Include="..\IronworkingExpanded.Tests\IronworkingExpanded.Tests.csproj" />
    <ProjectReference Include="..\LowPressureExpanded.Tests\LowPressureExpanded.Tests.csproj" />
  </ItemGroup>

  <!-- The base pipe block + BE live in iwex, and the shared pipe builders in its test project.
       Expose both project-wide so the many scene/scenario files that build pipe runs do not each
       need the using (no ambiguity: these names exist only there). -->
  <ItemGroup>
    <Using Include="IronworkingExpanded.BlockNetworkPipe.Blocks" />
    <Using Include="IronworkingExpanded.BlockNetworkPipe.BlockEntities" />
    <Using Include="IronworkingExpanded.Tests" />
  </ItemGroup>
</Project>
