<Project>
  <!--
    Test projects reuse the same per-target-framework game install resolution as the mods under
    src/, so legacy test runs (-p:Legacy=true) compile against the matching 1.21 (net8.0) / 1.20
    (net7.0) API and fall back to 1.22 (net10.0) otherwise. Importing the src props gives the test
    csprojs $(GamePath)/$(GameVersion) per TFM plus the missing-install guard and the legacy CS8625
    suppression. The runtime VsAssemblyResolver picks the matching install the same way (env-var
    override, else the in-repo .game/<slug>) so the headless run loads the right version's assemblies.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\src\Directory.Build.props" />

  <PropertyGroup>
    <!-- Run the test assemblies in parallel across all cores. Applied automatically by
         `dotnet test` / the IDE runner. The scripts/exmod helper runs the per-version suites
         concurrently on top of this.

         Within an assembly, xunit.runner.json turns collection parallelism OFF. Each mod reads its
         config live from a process-global register (IiexValues, SmexValues, HpexValues), and around
         twenty tests retune one mid-run through `Values.Edit`, so a class exercising production code
         can observe another class's temporary values. Such a failure appears only under parallel
         load and passes on every standalone re-run. Assembly-level parallelism is where the
         wall-clock comes from anyway: a whole suite is a few hundred milliseconds. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)parallel.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <Content
      Include="$(MSBuildThisFileDirectory)xunit.runner.json"
      Link="xunit.runner.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <!--
    On the legacy target frameworks, bring exlib's LegacyApi/LegacyAnimUtil extension members into
    scope across every test assembly, so test code written against the 1.22 API surface compiles
    unchanged on 1.20/1.21 - the same thing each mod project does with its own LegacyUsings.cs.
    Without this a test touching a 1.22-only member (e.g. MultiblockStructure.TransformedOffsets)
    fails the legacy build even though the production code it exercises has a working shim.
  -->
  <ItemGroup Condition="'$(IsCurrentGame)' != 'true'">
    <Using Include="ExpandedLib.Legacy" />
  </ItemGroup>
</Project>
