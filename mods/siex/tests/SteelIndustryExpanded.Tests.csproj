<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10 (1.22) by default; -p:Legacy=true also tests net8.0 (1.21) + net7.0 (1.20). The
         scripts/run-tests.* helper (and the "Test: …" VS Code tasks) run each version separately. -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Mocking framework for faking the game's big API interfaces in BE/unit tests. -->
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy iiex.dll + siex.dll into the test bin so the runner loads them headlessly; their VS
         deps are resolved by VsAssemblyResolver from the $(VINTAGE_STORY) install. -->
    <ProjectReference Include="..\..\iiex\src\IronIndustryExpanded.csproj" />
    <ProjectReference Include="..\src\SteelIndustryExpanded.csproj" />
    <!-- Content-specific fixtures follow the mod chain: the pipe builders come from the iiex suite,
         the boiler/engine plants from the iiex suite. -->
    <ProjectReference Include="..\..\iiex\tests\IronIndustryExpanded.Tests.csproj" />
  </ItemGroup>

  <!-- Dual mode, same switch as siex's mod project: source mode ProjectReferences exlib and the
       harness straight from the checkout, package mode takes them from NuGet. exlib's own test
       project (ExpandedLib.Tests) does not survive the split - it is exlib's, not a dependency this
       repository can carry a reference to; the one thing this suite took from it, exlib's own
       release-history seed (one shipped code, one version row), is reproduced locally in
       ExlibReleasedHistorySeed.cs instead. -->
  <ItemGroup Condition="'$(ExlibRoot)' != ''">
    <ProjectReference Include="$(ExlibRoot)src\ExpandedLib.csproj" />
    <ProjectReference Include="$(ExlibRoot)testing\ExpandedLib.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExlibRoot)' == ''">
    <PackageReference Include="ExpandedLib" />
    <PackageReference Include="ExpandedLib.Testing" />
  </ItemGroup>

  <!-- The base pipe block + BE live in exlib, and the shared pipe builders in the iiex test project.
       Expose both project-wide so the many scene/scenario files that build pipe runs do not each
       need the using (no ambiguity: these names exist only there). -->
  <ItemGroup>
    <Using Include="ExpandedLib.Networks" />
    <Using Include="IronIndustryExpanded.Tests" />
  </ItemGroup>
</Project>
