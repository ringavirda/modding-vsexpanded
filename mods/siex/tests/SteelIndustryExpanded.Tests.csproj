<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10 (1.22) by default; -p:Legacy=true also tests net8.0 (1.21) + net7.0 (1.20). The
         scripts/run-tests.* helper (and the "Test: …" VS Code tasks) run each version separately. -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Mocking framework for faking the game's big API interfaces in BE/unit tests. -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy exlib.dll + iiex.dll + siex.dll into the test bin so the runner loads them headlessly;
         their VS deps are resolved by VsAssemblyResolver from the $(VINTAGE_STORY) install. -->
    <ProjectReference Include="..\..\exlib\src\ExpandedLib.csproj" />
    <ProjectReference Include="..\..\iiex\src\IronIndustryExpanded.csproj" />
    <ProjectReference Include="..\src\SteelIndustryExpanded.csproj" />
    <ProjectReference Include="..\..\exlib\testing\ExpandedLib.Testing.csproj" />
    <!-- Content-specific fixtures follow the mod chain: the pipe builders come from the iiex suite,
         the boiler/engine plants from the iiex suite. -->
    <ProjectReference Include="..\..\iiex\tests\IronIndustryExpanded.Tests.csproj" />
    <!-- ReleasedCodeCoverageTests/ReleasedEntityClassTests are the only suite that checks all three
         mods' shipped history together, so exlib's release-history registration has to load here too. -->
    <ProjectReference Include="..\..\exlib\tests\ExpandedLib.Tests.csproj" />
  </ItemGroup>

  <!-- The base pipe block + BE live in exlib, and the shared pipe builders in the iiex test project.
       Expose both project-wide so the many scene/scenario files that build pipe runs do not each
       need the using (no ambiguity: these names exist only there). -->
  <ItemGroup>
    <Using Include="ExpandedLib.Networks" />
    <Using Include="IronIndustryExpanded.Tests" />
  </ItemGroup>
</Project>
