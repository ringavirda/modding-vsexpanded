<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10 (1.22) by default; -p:Legacy=true also tests net8.0 (1.21) + net7.0 (1.20). The
         scripts/run-tests.* helper (and the "Test: …" VS Code tasks) run each version separately. -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=true (unlike the other test projects, which leave it false). The vstest discoverer
         probes a test assembly's direct references on disk BEFORE the harness's assembly resolver can
         run; when a reference is not in the output folder it can silently SKIP the whole assembly
         ("could not find dependent assembly '<name>, Version=…'") and report zero tests rather than
         failing - which is how this project quietly contributed nothing on the legacy lane. Confirmed
         for VSSurvivalMod too (`diag.host.*.log`): testhost's own AssemblyResolver fails its first,
         path-only probe and throws ReflectionTypeLoadException during discovery's type scan, before
         VsAssemblyResolver gets a chance to answer the same request from the .game install (later
         requests then resolve "from cache" - too late, discovery already gave up on the assembly).
         Copying the dll in is dev-only output (never shipped) and makes discovery deterministic. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Mocking framework for faking the game's big API interfaces in BE/unit tests. -->
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy exlib.dll + iiex.dll into the test bin so the runner loads them headlessly; their VS
         deps are resolved by VsAssemblyResolver from the $(VINTAGE_STORY) install. iiex is the
         lowest content mod, so this project references NO other mod. -->
    <ProjectReference Include="..\src\IronIndustryExpanded.csproj" />
  </ItemGroup>

  <!-- Dual mode, same switch as the mod project above: source mode ProjectReferences exlib and the
       harness straight from the checkout, package mode takes them from NuGet. Plain (no
       ExcludeAssets/Private=false) in both branches - a test project loads exlib.dll and
       ExpandedLib.Testing.dll at test time, unlike the mod project which never ships either. -->
  <ItemGroup Condition="'$(ExlibRoot)' != ''">
    <ProjectReference Include="$(ExlibRoot)src\ExpandedLib.csproj" />
    <ProjectReference Include="$(ExlibRoot)testing\ExpandedLib.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExlibRoot)' == ''">
    <PackageReference Include="ExpandedLib" />
    <PackageReference Include="ExpandedLib.Testing" />
  </ItemGroup>

  <!-- The base pipe block + BE live in exlib and the shared pipe builders (PipeTestWorld) here.
       Exposed project-wide so the many scene/scenario files that build pipe runs do not each need
       the using; no ambiguity, since these names exist only there. -->
  <ItemGroup>
    <Using Include="ExpandedLib.Networks" />
  </ItemGroup>
</Project>
