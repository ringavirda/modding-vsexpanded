<Project>
  <!--
    ============================================================================================
    VERSION MANIFEST, PACKAGE-SIDE HALF. Shipped in the nupkg (build/ExpandedLib.props) and
    imported into every consuming project's props stage, before its project body. The three
    defaults below are guarded with Condition="'$(X)' == ''", so a consumer that sets its own
    manifest first - this repo's ../../Directory.Build.props does - keeps its own values; this
    file only supplies them for a project with no manifest of its own (a standalone clone, a
    third party). See ../../Directory.Build.props for the rest of the manifest story (why it's
    properties not items, how the promote/add-a-version workflow goes).

    $(TargetFramework) and $(AssetDomain) are set in the CONSUMER'S PROJECT BODY, evaluated after
    this file, so anything here that depends on them is silently empty - that's why GamePath, the
    GAME_GE_* constants and the asset globs live in ExpandedLib.targets instead, imported after
    the body. $(_GameTfm) below works around it for the single-target case only, by falling back
    to $(CurrentGameTfm) when $(TargetFramework) is still empty.
    ============================================================================================
  -->
  <PropertyGroup>
    <CurrentGameTfm Condition="'$(CurrentGameTfm)' == ''">net10.0</CurrentGameTfm>
    <CurrentGameVer Condition="'$(CurrentGameVer)' == ''">1.22.0</CurrentGameVer>
    <AllGameTfms Condition="'$(AllGameTfms)' == ''">net7.0;net8.0;net10.0</AllGameTfms>
  </PropertyGroup>

  <PropertyGroup>
    <_GameTfm>$(TargetFramework)</_GameTfm>
    <_GameTfm Condition="'$(_GameTfm)' == ''">$(CurrentGameTfm)</_GameTfm>
    <IsCurrentGame Condition="'$(_GameTfm)' == '$(CurrentGameTfm)'"
      >true</IsCurrentGame>
  </PropertyGroup>

  <!-- GameVer is the game-version FLOOR each TFM supports - the .0 of the series - and is stamped
       into the legacy output modinfo. The mods are kept source-compatible with that .0 release (so
       a player on any patch of the series can run them); the legacy shims target the .0 API surface.
       (The GAME_GE_* thresholds compare on major.minor, so the patch component is irrelevant there.)

       Per-version facts: game version floor + the .game/<slug> folder it provisions into + the env
       var that can override the install location. One per TFM. -->
  <PropertyGroup Condition="'$(_GameTfm)' == 'net10.0'">
    <GameVer>1.22.0</GameVer>
    <GameSlug>1.22</GameSlug>
    <GameInstallEnv>VINTAGE_STORY</GameInstallEnv>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_GameTfm)' == 'net8.0'">
    <GameVer>1.21.0</GameVer>
    <GameSlug>1.21</GameSlug>
    <GameInstallEnv>VINTAGE_STORY_121</GameInstallEnv>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_GameTfm)' == 'net7.0'">
    <GameVer>1.20.0</GameVer>
    <GameSlug>1.20</GameSlug>
    <GameInstallEnv>VINTAGE_STORY_120</GameInstallEnv>
  </PropertyGroup>

  <!--
    ============================================================================================
    ASSEMBLY IDENTITY AND XML DOCS, for the five projects that ship as mods.

    Keyed on the project having its own modinfo.json, NOT on $(AssetDomain): modinfo.json is
    present for exactly the five mod projects and absent from ExpandedLib.Generators and every
    test project, so it is both the correct marker and one that is available this early (it's a
    file check, not a property read from the body). This has to live here, in the props half, not
    in ExpandedLib.targets: $(GenerateDocumentationFile) drives Microsoft.Common.CurrentVersion
    .targets's own $(_DocumentationFileProduced) default, computed as a plain (non-Target)
    property near the TOP of that file - well before Directory.Build.targets (and so this
    package's .targets half) is imported. Set from there, it arrives one static-evaluation pass
    too late: the SDK has already locked the doc-file copy off, and dotnet pack ships a dll with
    no .xml beside it despite Csc having written one.

    VERSION. Every release shipped AssemblyVersion/FileVersion 1.0.0.0, so nothing outside the
    running game could tell one build from another: the only version identity was a string in
    modinfo.json, readable at runtime only, after the mod had already loaded and possibly already
    called a method that no longer exists. modinfo.json stays the single source - the version is read
    out of it rather than duplicated - so the two cannot drift and a release still edits one file.
    AssemblyVersion deliberately stays major.minor.0.0 while FileVersion carries the patch: a binding
    identity that changed on every patch would break a dependent mod's assembly reference over a
    bugfix, which is not what a patch release means.

    DOCS. Nearly every public member carries a <summary> explaining the engine trap it exists for
    rather than restating the signature, and none of it reached a consumer - no .xml was produced, so
    a third party referencing the shipped dll got bare signatures across the whole public surface
    while vanilla's own types showed full tooltips in the same IntelliSense list. CS1591 (missing
    comment on a public member) is suppressed rather than gated: producing the file is the change,
    and burning down the undocumented remainder is a separate pass that should not block it.
    ============================================================================================
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\modinfo.json')">
    <ModVersion Condition="'$(ModVersion)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\modinfo.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
    <Version>$(ModVersion)</Version>
    <FileVersion>$(ModVersion)</FileVersion>
    <InformationalVersion>$(ModVersion)</InformationalVersion>
    <AssemblyVersion>$([System.Version]::Parse('$(ModVersion)').Major).$([System.Version]::Parse('$(ModVersion)').Minor).0.0</AssemblyVersion>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 missing comment on a public member - the undocumented remainder, a separate pass.
         CS1573 a parameter has no <param> tag - this codebase documents behaviour in <summary> prose
           rather than tagging every parameter, deliberately, so this fires on the house style.
         CS0419 an ambiguous cref across an overload set - the link still resolves to one of them.
         ⛔ CS1574 (a cref that resolves to NOTHING) is deliberately NOT suppressed: it is the only
         one of these that catches a doc statement which has gone stale against the code, and turning
         the doc file on found six on the first build. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
  </PropertyGroup>
</Project>
