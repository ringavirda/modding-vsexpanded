<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Primary build is the current game version, single-target. Opt into the older versions
         with -p:Legacy=true; both the primary TFM and the full legacy set come from the manifest
         in ../../Directory.Build.props (add a version there, not here). -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The current version keeps the flat output path; legacy TFMs get their own subfolder so the
         builds don't overwrite each other. -->
    <OutputPath
      Condition="'$(IsCurrentGame)' != 'true' and '$(TargetFramework)' != ''"
      >bin\$(Configuration)\$(TargetFramework)\Mods\mod</OutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''"
      >bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
    <!-- Assembly name matches the mod id so the built lib ships as exlib.dll. -->
    <AssemblyName>exlib</AssemblyName>
    <RootNamespace>ExpandedLib</RootNamespace>
    <!-- This mod's asset domain; the shared globs in ../../Directory.Build.props pull in
         ../assets/ (Content + the en.json ExLangKeyGenerator feed). -->
    <AssetDomain>exlib</AssetDomain>
  </PropertyGroup>

  <!-- NuGet pack metadata. PackageId, Description and IsPackable stay here - the rest (version,
       authors, urls, license, readme filename, icon, tags, symbols) is shared across the three
       packable exlib projects and lives in ../Directory.Build.props. The game assemblies above stay
       References with Private=false - dotnet pack never bundles a Reference, only
       PackageReference/ProjectReference content or explicit Content/None items, so they are never
       at risk of ending up in the nupkg. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ExpandedLib</PackageId>
    <Description>Shared framework library for the Fallenstar's Expanded mods (Vintage Story).</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The shared glob in ../../Directory.Build.targets marks this mod's assets/modinfo/modicon as
       Content so the game's Mods/mod folder gets them; dotnet pack packs every Content item into
       the nupkg by default, which would ship the whole assets tree alongside the dll. The nupkg is
       a compile-time reference, not the mod - only the dll, its xml docs and the readme belong in
       it. A plain ItemGroup runs too early to see those items (Directory.Build.targets is imported
       after this file), so the override happens in a Target instead. -->
  <Target Name="ExcludeAssetsFromPack" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <ItemGroup>
      <Content Update="@(Content)" Pack="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The engine's object loader casts every blocktypes/ asset to the concrete
         Vintagestory.Common.Asset, so code-first definition injection (Definitions/) must construct
         real Asset instances - a custom IAsset throws InvalidCastException. -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(GamePath)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VGameContent">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VGameContent">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(GamePath)/Lib/cairo-sharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/Lib/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(GamePath)/Lib/protobuf-net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Doubles as the game's mod icon (CopyToOutputDirectory) and the nupkg icon (Pack/PackagePath -
       ../Directory.Build.props sets $(PackageIcon)). Kept as None rather than Content: the
       ExcludeAssetsFromPack target below sets Pack=false on every @(Content) item, and NuGet's own
       pack targets exclude a packed file by matching its PACKAGE-ROOT NAME against any excluded
       Content, not by source identity - a Content item here would collide with this file's own
       nupkg destination name and silently drop the icon (NU5046). -->
  <ItemGroup>
    <None
      Include="modicon.png"
      Condition="Exists('modicon.png')"
      CopyToOutputDirectory="PreserveNewest"
      Pack="true"
      PackagePath="modicon.png"
    />
  </ItemGroup>

  <!-- The config source generator emits the ExlibValues accessor from ExlibConfig's
       [ExConfigRegister]; ExLangKeyGenerator emits the ExlibLang key constants. Compile-time
       only (Analyzer), ships nothing. -->
  <ItemGroup>
    <ProjectReference
      Include="..\generators\ExpandedLib.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- Stamp the matching game version into the output modinfo for legacy builds, so the mod
       isn't rejected by the older game's version-dependency check. $(GameVersion) is only set
       for the legacy TFMs (../../Directory.Build.props), so this is a no-op for the 1.22 build. -->
  <Target
    Name="RewriteModinfoGameVersion"
    AfterTargets="Build"
    Condition="'$(GameVersion)' != ''"
  >
    <WriteLinesToFile
      File="$(OutDir)modinfo.json"
      Lines="$([System.IO.File]::ReadAllText('$(OutDir)modinfo.json').Replace('&quot;game&quot;: &quot;$(CurrentGameVer)&quot;', '&quot;game&quot;: &quot;$(GameVersion)&quot;'))"
      Overwrite="true"
    />
  </Target>
</Project>
