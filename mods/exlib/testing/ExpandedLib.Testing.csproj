<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10 (1.22) by default; opt into legacy game APIs with -p:Legacy=true to also test on
         net8.0 (1.21) and net7.0 (1.20). $(GamePath) per TFM comes from ../../Directory.Build.props. -->
    <TargetFramework Condition="'$(Legacy)' != 'true'"
      >$(CurrentGameTfm)</TargetFramework>
    <TargetFrameworks Condition="'$(Legacy)' == 'true'"
      >$(AllGameTfms)</TargetFrameworks>
    <!-- A single-TFM build keeps the stable flat output path; multi-target must append the TFM to
         avoid the three builds colliding in one folder. -->
    <AppendTargetFrameworkToOutputPath Condition="'$(Legacy)' != 'true'"
      >false</AppendTargetFrameworkToOutputPath>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ExpandedLib.Testing</RootNamespace>
    <AssemblyName>ExpandedLib.Testing</AssemblyName>
    <!-- Not a game mod - never copied into a Mods/mod folder - but packable as a developer library;
         see the pack metadata below and infra/CakeBuild's PackageTesting task for the older,
         NuGet-free dev bundle this repo also still ships on a release. -->
    <IsPackable>true</IsPackable>
    <!-- ../../Directory.Build.props only turns this on for a project with its own modinfo.json (a
         mod); this project has none, so it opts in for itself - the nupkg ships IntelliSense docs.
         Same NoWarn as a mod project gets from that props file, for the same reason: an undocumented
         public member or an untagged parameter is a real backlog, not something this pass burns
         down; CS1574 (a cref resolving to nothing) stays a warning. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
  </PropertyGroup>

  <!-- NuGet pack metadata. PackageId and Description stay here (IsPackable is already set above) -
       the rest (version, authors, urls, license, readme filename, icon, tags, symbols) is shared
       across the three packable exlib projects and lives in ../Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>ExpandedLib.Testing</PackageId>
    <Description>Headless xUnit test harness for ExpandedLib (Vintage Story) - loads the real game assemblies and drives network/block-entity logic under plain dotnet test.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- LoadAssets drives the engine's own object loader, which casts every blocktypes/ asset to the
         concrete Vintagestory.Common.Asset and reads worldproperties through protobuf-net-serialized
         fields - same reasons exlib's own src project references both (see its ExpandedLib.csproj). -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(GamePath)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(GamePath)/Lib/protobuf-net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/Lib/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The harness fakes the big VS interfaces (IBlockAccessor, IServerWorldAccessor) by
         wiring an NSubstitute proxy to a stateful in-memory store. -->
    <PackageReference Include="NSubstitute" />
    <!-- StaticStateCollection's guard reads xUnit's [Collection]/[CollectionDefinition] attributes off
         a test assembly; every consumer of this harness is an xUnit project, so this is not a new
         runtime dependency for anyone who links it. -->
    <PackageReference Include="xunit.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\ExpandedLib.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- DefinitionGoldens replays the generated metal family through MetalFamilyEmitter/MetalDef to
         golden-check it like any other code-first def. -->
    <ProjectReference Include="..\industry\ExpandedLib.Industry.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
