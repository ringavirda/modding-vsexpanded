<Project>
  <!-- Pulls in the version manifest, the test-only settings and everything else
       mods/Directory.Build.props sets for every project under mods/ - this file only adds to it,
       it never replaces it. GetPathOfFileAbove starts its search one directory above this file
       (mods/), so it lands on mods/Directory.Build.props, not this one. -->
  <Import
    Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
  />

  <!-- Pack metadata shared by the three packable exlib projects (ExpandedLib, ExpandedLib.Industry,
       ExpandedLib.Testing) - everything that is identical across them, so a release edits it once
       instead of three times. PackageId, Description, IsPackable and the readme None item stay in
       each csproj: those three differ per project, and the readme path is relative to each
       project's own folder. -->
  <PropertyGroup
    Condition="'$(MSBuildProjectName)' == 'ExpandedLib'
      or '$(MSBuildProjectName)' == 'ExpandedLib.Industry'
      or '$(MSBuildProjectName)' == 'ExpandedLib.Testing'"
  >
    <!-- Version is read from exlib's own modinfo.json rather than duplicated, so a release only
         ever bumps one number - the three packages ship in lockstep. -->
    <_ModinfoJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)src\modinfo.json'))</_ModinfoJson>
    <PackageVersion
      >$([System.Text.RegularExpressions.Regex]::Match($(_ModinfoJson), '&quot;version&quot;:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</PackageVersion>

    <Authors>fallenstar</Authors>
    <RepositoryUrl>https://github.com/ringavirda/modding-vsexpanded</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/ringavirda/modding-vsexpanded/wiki</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>vintagestory mod framework exlib</PackageTags>

    <!-- One shared icon for all three, read from src/ regardless of which project is packing -
         Industry and Testing carry no modicon.png of their own. -->
    <PackageIcon>modicon.png</PackageIcon>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- The icon, packed to the package root under its own name. ExpandedLib.csproj owns
       src/modicon.png and declares this item itself, next to its own copy of the file (see the
       comment there for why a plain Include here would collide with it and silently drop the icon
       from the nupkg - NU5046). Industry and Testing carry no modicon.png of their own, so the
       plain Include below is all they need. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ExpandedLib.Industry' or '$(MSBuildProjectName)' == 'ExpandedLib.Testing'">
    <None Include="$(MSBuildThisFileDirectory)src\modicon.png" Pack="true" PackagePath="modicon.png" />
  </ItemGroup>
</Project>
