<Project Sdk="Microsoft.NET.Sdk">
  <!-- samples/ sits outside mods/, so it does not inherit mods/Directory.Build.props the way every
       mod project does automatically (MSBuild only walks up from a project's own folder). Import
       the shared build files directly instead - the props here, the targets at the bottom of this
       file - which is exactly what a third-party mod's own project gets from the ExpandedLib
       package; see the wiki's Getting-Started for the standalone form. Source mode only
       ($(ExlibRoot) != ''): in package mode the PackageReference below pulls the same two files in
       automatically (the NuGet build/<id>.props|targets convention), and importing both ways would
       double them up. -->
  <PropertyGroup>
    <!-- The source-mode switch, canonically set in mods/Directory.Build.props; this project builds
         standalone (dotnet build on this .csproj directly, no other import reaches it first), so it
         carries the same one-line default rather than importing that whole file, which would also
         pull in the version manifest and test-only settings this project has no use for.
         -p:ExlibRoot= (a global property) wins over this default and forces package mode. -->
    <ExlibRoot Condition="'$(ExlibRoot)' == ''"
      >$(MSBuildThisFileDirectory)../../mods/exlib/</ExlibRoot>
    <!-- Restore needs $(TargetFramework) (below, reading $(CurrentGameTfm)) before any package is
         present, so in package mode it can't come through ExpandedLib.props - the same reason the
         target framework list always stays in the consumer, never the package. Source mode's
         ExpandedLib.props sets the same default, guarded the same way, so this only ever fires
         first. -->
    <CurrentGameTfm Condition="'$(CurrentGameTfm)' == ''"
      >net10.0</CurrentGameTfm>
  </PropertyGroup>
  <Import
    Project="../../mods/exlib/build/ExpandedLib.props"
    Condition="'$(ExlibRoot)' != ''"
  />

  <PropertyGroup>
    <!-- Primary build is the current game version, single-target; the legacy lanes buy nothing for
         a sample that exists to be read, so this stays on $(CurrentGameTfm) even with -p:Legacy=true. -->
    <TargetFramework>$(CurrentGameTfm)</TargetFramework>
    <LangVersion>14</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
    <AssemblyName>helloexpanded</AssemblyName>
    <RootNamespace>HelloExpanded</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Inside this monorepo (source mode, $(ExlibRoot) != '') exlib is a plain ProjectReference with
    copy-local off - the player installs exlib as its own mod, so it must not ship a second copy
    inside helloexpanded's folder; the generators come along as an analyzer ProjectReference. A
    standalone clone (package mode, $(ExlibRoot) == '', forced with -p:ExlibRoot=) has no such
    checkout to reference and takes the ExpandedLib package instead - see the wiki's Getting-Started
    "Reference exlib at compile time" for the whole standalone form. The package carries the
    generators as analyzers and the build/ plumbing, so the package branch needs nothing else.
  -->
  <ItemGroup Condition="'$(ExlibRoot)' != ''">
    <ProjectReference Include="$(ExlibRoot)src\ExpandedLib.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- The config source generator emits HelloValues from HelloConfig's [ExConfigRegister];
         ExLangKeyGenerator emits HelloExpandedLang. Compile-time only, ships nothing. -->
    <ProjectReference
      Include="$(ExlibRoot)generators\ExpandedLib.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(ExlibRoot)' == ''">
    <PackageReference Include="ExpandedLib" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- hellomodule is a sample dependency inside this repo, not a package - referenced by project in
       both modes. Copy-local off for the same reason as exlib above: the player installs
       hellomodule as its own mod. -->
  <ItemGroup>
    <ProjectReference Include="..\HelloModule\HelloModule.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Imported last so the properties it needs from the project body ($(TargetFramework),
       $(AssetDomain) - unset here, so its asset globs stay inert) are already evaluated; see
       ExpandedLib.targets for what this pulls in (GamePath, provisioning, the capability
       constants). This project carries no AssetDomain of its own, so its assets/ (a direct sibling
       of the csproj, not one level up under src/) is still globbed by hand below. Source mode only,
       same reason as the .props import above. -->
  <Import
    Project="../../mods/exlib/build/ExpandedLib.targets"
    Condition="'$(ExlibRoot)' != ''"
  />

  <ItemGroup>
    <Content Include="assets/**/*">
      <Link>assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <AdditionalFiles Include="assets/helloexpanded/lang/en.json" />
  </ItemGroup>
</Project>
